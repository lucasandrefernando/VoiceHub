{
    "name": "seu-nome/voicehub",
    "description": "Plataforma de transcrição e análise de áudio",
    "type": "project",
    "require": {
        "php": "^7.4|^8.0",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "firebase/php-jwt": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "nome-do-pacote-vulneravel": false
        }
    }
}
